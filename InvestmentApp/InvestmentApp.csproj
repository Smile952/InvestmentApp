<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="contracts\instruments.proto" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Api.CommonProtos" Version="2.17.0" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="contracts\common.proto" GrpcServices="Both" />
    <Protobuf Include="contracts\instruments.proto" />
    <Protobuf Include="contracts\marketdata.proto" GrpcServices="Client" />
    <Protobuf Include="contracts\operations.proto" GrpcServices="Client" />
    <Protobuf Include="contracts\orders.proto" GrpcServices="Client" />
    <Protobuf Include="contracts\sandbox.proto" GrpcServices="Client" />
    <Protobuf Include="contracts\signals.proto" GrpcServices="Client" />
    <Protobuf Include="contracts\stoporders.proto" GrpcServices="Client" />
    <Protobuf Include="contracts\users.proto" GrpcServices="Client" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ProjectExtensions><VisualStudio><UserProperties appsettings_1json__JsonSchema="" /></VisualStudio></ProjectExtensions>

</Project>
